# =======================================================
# Finamax - .gitignore
# =======================================================

# Firebase configuration and credentials
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*.env
*.env.local
*.env.*

# 1. Binarios y compilados
build/
**/build/
dist/
**/dist/
*.apk
*.aab
*.lock
app.*.symbols
app.*.map.json
/android/app/release

# 2. Archivos temporales de Dart / Flutter y dependencias
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
node_modules/
venv/
.venv/

# 3. Credenciales y secretos locales sensibles
local.properties
**/local.properties
key.properties
**/key.properties
*.keystore
**/*.keystore
*.jks
**/*.jks

# 4. Caché del IDE y editores
.idea/
.vscode/
*.iml
*.ipr
*.iws

# 5. Gradle y sistema operativo
.gradle/
**/.gradle/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
